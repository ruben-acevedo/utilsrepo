touch "nome" = cria um arquivo
mkdir "nome" = cria uma pasta (diretorio)
cd "nome" = abre pasta/local
cd .. = volta 
ls = mostra todos os arq e pastas no diretorio (ls -l)
code . = abre o vscode
mv "nome antigo" "nome novo" = muda o nome
py "nome" = executa o programa Python 
trash "nome" = joga na lixeira um arquivo
rm "nome" = remove de vez o arquivo
rm -rf "nome" = remove arquivo e diretorio

git config --global core.editor "code -- wait" = config geral do vscode
git config --global -e = abre o arquivo de edição acima
git config --global --list = lista as configurações
git init = inicia o git (necessário)
git remote add origin "URL" = adiciona para onde vai os codigos
git clone "URL" = clona um repositorio 
git remote -v = verifica se tem o push e fetch
git add "nome" = tira foto do codigo (git add .) - tudo
git commit = salva e abre o editor para msg mais detalhada
git commit -m "mensagem" = salva com mensagem
git commit -am "mensagem" = tira foto e salva, para arq ja existente
git push -u origin master (ou main) = indica em qual branch vai salvar (depois git push direto)
git branch -d(-D) main (ou master) = deleta uma branch, dependendo de qual estiver
git push origin --delete main (ou master) = deleta uma branch 
git switch "branch" = muda de branch
git checkout -b main "origin/main" = recupera a branch deletada
git status = verifica o status do seu repositorio (verde pode levar commit)
git log = mostra o historico de commits ("q" sai)
git pull origin master(ou main) = atualiza tudo, tras tudo da origem (arruma)
git push origin master(ou main) = leva tudo para a origem